# Configure in your local .env.local and Vercel's protected environment settings.
# These MUST point to the separate EagleScore Supabase project, not Campus Link.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key for controlled invitations/approvals/CMS. NEVER prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Used for safe redirects in invite and reset links.
NEXT_PUBLIC_SITE_URL=https://eaglescore-xi.vercel.app
